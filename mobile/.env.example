# Base URL of the API gateway. When testing on a physical device replace
# localhost with your computer's LAN IP, e.g. http://192.168.1.20:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# ----- Google Sign-In -----
# OAuth client ids from the Google Cloud project behind Firebase
# (Firebase Console → Authentication → Sign-in method → Google, then
#  Project settings → download the updated GoogleService-Info.plist /
#  google-services.json).
#
# Both are needed even though only one runs per platform: Android mints its ID
# token with the WEB client as the audience, iOS with the iOS client. Leave
# empty to hide the Google button entirely.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
